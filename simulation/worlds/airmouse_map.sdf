<?xml version="1.0"?>

<sdf version="1.9">
  <world name="airmouse_map">

    <!-- ==================== PHYSICS ==================== -->
    <gravity>0 0 -9.81</gravity>

    <!-- Earth's magnetic field in Tesla -->
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>


    <!-- ==================== LIGHTING ==================== -->
    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.15 0.15 0.15 1</background>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 -0.5 -1</direction>
    </light>


    <!-- ==================== GROUND ==================== -->
    <model name="ground">
      <static>true</static>

      <link name="ground_link">
        <collision name="ground_collision">
          <pose>0 0 -0.05 0 0 0</pose>
          <geometry>
            <box>
              <size>20 20 0.1</size>
            </box>
          </geometry>
        </collision>

        <visual name="ground_visual">
          <pose>0 0 -0.05 0 0 0</pose>
          <geometry>
            <box>
              <size>20 20 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.6 0.8 0.6 1</ambient>
            <diffuse>0.6 0.8 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>


    <!-- ==================== NORTH WALL ==================== -->
    <model name="north_wall">
      <static>true</static>

      <link name="wall_link">
        <pose>0 10 1 0 0 0</pose>

        <collision name="wall_collision">
          <geometry>
            <box>
              <size>20 0.2 2</size>
            </box>
          </geometry>
        </collision>

        <visual name="wall_visual">
          <geometry>
            <box>
              <size>20 0.2 2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.1 0.1 1</ambient>
            <diffuse>0.8 0.1 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>


    <!-- ==================== SOUTH WALL ==================== -->
    <model name="south_wall">
      <static>true</static>

      <link name="wall_link">
        <pose>0 -10 1 0 0 0</pose>

        <collision name="wall_collision">
          <geometry>
            <box>
              <size>20 0.2 2</size>
            </box>
          </geometry>
        </collision>

        <visual name="wall_visual">
          <geometry>
            <box>
              <size>20 0.2 2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.1 0.1 1</ambient>
            <diffuse>0.8 0.1 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>


    <!-- ==================== EAST WALL ==================== -->
    <model name="east_wall">
      <static>true</static>

      <link name="wall_link">
        <pose>10 0 1 0 0 0</pose>

        <collision name="wall_collision">
          <geometry>
            <box>
              <size>0.2 20 2</size>
            </box>
          </geometry>
        </collision>

        <visual name="wall_visual">
          <geometry>
            <box>
              <size>0.2 20 2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.1 0.1 1</ambient>
            <diffuse>0.8 0.1 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>


    <!-- ==================== WEST WALL ==================== -->
    <model name="west_wall">
      <static>true</static>

      <link name="wall_link">
        <pose>-10 0 1 0 0 0</pose>

        <collision name="wall_collision">
          <geometry>
            <box>
              <size>0.2 20 2</size>
            </box>
          </geometry>
        </collision>

        <visual name="wall_visual">
          <geometry>
            <box>
              <size>0.2 20 2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.1 0.1 1</ambient>
            <diffuse>0.8 0.1 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>


    <!-- ==================== OBSTACLE 1 ==================== -->
    <model name="obstacle_1">
      <static>true</static>

      <link name="obstacle_link">
        <pose>2 1 1 0 0 0</pose>

        <collision name="obstacle_collision">
          <geometry>
            <box>
              <size>2 2 2</size>
            </box>
          </geometry>
        </collision>

        <visual name="obstacle_visual">
          <geometry>
            <box>
              <size>2 2 2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.1 0.2 0.8 1</ambient>
            <diffuse>0.1 0.2 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>


    <!-- ==================== OBSTACLE 2 ==================== -->
    <model name="obstacle_2">
      <static>true</static>

      <link name="obstacle_link">
        <pose>-3 -1 1 0 0 0</pose>

        <collision name="obstacle_collision">
          <geometry>
            <box>
              <size>2 2 2</size>
            </box>
          </geometry>
        </collision>

        <visual name="obstacle_visual">
          <geometry>
            <box>
              <size>2 2 2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.9 0.8 0.1 1</ambient>
            <diffuse>0.9 0.8 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>


    <!-- ==================== OBSTACLE 3 ==================== -->
    <model name="obstacle_3">
      <static>true</static>

      <link name="obstacle_link">
        <pose>0 -2.5 0.75 0 0 0</pose>

        <collision name="obstacle_collision">
          <geometry>
            <box>
              <size>2 2 1.5</size>
            </box>
          </geometry>
        </collision>

        <visual name="obstacle_visual">
          <geometry>
            <box>
              <size>2 2 1.5</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.1 0.7 1</ambient>
            <diffuse>0.5 0.1 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>


  </world>
</sdf>
